{
  "secret-scrubber": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./scripts/scrub-secrets.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
