        const mId = `M_${m.replace(/-/g, '_')}`;
        console.log(`  ${aId} -.->|mcp| ${mId}["🔌 ${m}"]`);
      });
    });
    console.log('  %% Lifecycle Hooks');
    console.log('  subgraph Hooks["🛡️ Lifecycle Guardrails"]');
    hooks.forEach(h => {
      console.log(`    H_${h.name.replace(/-/g, '_')}["🛡️ ${h.name} (${h.event})"]`);
    });
    console.log('  end');
    console.log('```');
    return;
  }

  printBanner();
  console.log(`${BOLD}🗺️ Everything Gemini Multi-Agent Topology & Dependency Graph${RESET}\n`);
  console.log(`${GRAY}Showing 13 Scoped Subagents, 63 Progressive Skills, 14 MCP Blueprints, and 8 Lifecycle Hooks:${RESET}\n`);

  console.log(`${CYAN}${BOLD}🛡️ LIFECYCLE HOOKS (System Protection Boundary):${RESET}`);
  hooks.forEach(h => {
    console.log(`  ${YELLOW}◆${RESET} ${BOLD}${h.name.padEnd(22)}${RESET} ${GRAY}[${h.event}]${RESET} ── ${h.desc}`);
  });
  console.log('');

  console.log(`${CYAN}${BOLD}🤖 SCOPED SUBAGENTS & SKILL DEPENDENCIES:${RESET}`);
  agents.forEach(a => {
    console.log(`  ${GREEN}┌─●${RESET} ${BOLD}${a.name.toUpperCase()}${RESET} ${GRAY}(Agent)${RESET}`);
    if (a.mcps.length > 0) {
      console.log(`  ${GREEN}│${RESET}   ${MAGENTA}🔌 MCP Blueprints:${RESET} ${a.mcps.map(m => `${BOLD}${m}${RESET}`).join(', ')}`);
    }
    console.log(`  ${GREEN}│${RESET}   ${BLUE}📘 Primary Skills:${RESET}`);
    a.skills.forEach((s, idx) => {
      const isLast = idx === a.skills.length - 1;
      const branch = isLast ? '└──' : '├──';
      console.log(`  ${GREEN}│${RESET}     ${GRAY}${branch}${RESET} ${s}`);
    });
    console.log(`  ${GREEN}│${RESET}`);
  });
  console.log(`  ${GREEN}└──●${RESET} ${GRAY}All 63 Progressive Disclosure Skills indexed dynamically in catalog.${RESET}\n`);
  console.log(`${GRAY}Tip: Run ${CYAN}everything-gemini graph --mermaid${GRAY} for Mermaid diagram or ${CYAN}--json${GRAY} for raw graph data.${RESET}\n`);
}

function runPhpCheckCommand(subArgs) {
  if (subArgs.length === 0 || subArgs.includes('--help') || subArgs.includes('-h')) {
    console.log(`
${BOLD}🛡️ Everything Gemini PHP2Shell Patch Checker (CVE-2026-109618 / CVE-2026-109619)${RESET}

${BOLD}USAGE:${RESET}
  everything-gemini phpcheck <URL> [options]
  everything-gemini phpcheck --server [options]

${BOLD}COMMANDS & OPTIONS:${RESET}
  <URL>                       Scan remote web URL/hostname headers (Server, X-Powered-By)
  --server, --local           Audit local server/container PHP packages and active workers
  --json                      Emit structured JSON report for CI/CD and automation
  --timeout <seconds>         HTTP connection timeout in seconds (default: 10s)
  --help, -h                  Show this help message

${BOLD}EXAMPLES:${RESET}
  everything-gemini phpcheck https://example.com
  everything-gemini phpcheck https://example.com --json
  everything-gemini phpcheck --server
`);
    return;
  }

  const isServer = subArgs.includes('--server') || subArgs.includes('--local');
  if (isServer) {
    const scriptPath = path.join(REPO_ROOT, 'skills', 'phpcheck-server', 'scripts', 'audit-server.sh');
    const jsonFlag = subArgs.includes('--json') ? ' --json' : '';
    try {
      execSync(`bash "${scriptPath}"${jsonFlag}`, { stdio: 'inherit', cwd: WORKSPACE_DIR });
    } catch (err) {
      process.exitCode = err.status || 1;
    }
    return;
  }

  const { runPhpCheck } = require(path.join(REPO_ROOT, 'skills', 'phpcheck-url', 'scripts', 'phpcheck.js'));
  runPhpCheck(subArgs).catch(err => {
    console.error('Check failed:', err.message);
    process.exitCode = 2;
  });
}

// CLI Argument Parsing
const args = process.argv.slice(2);
const command = args[0] || 'help';

switch (command) {
  case 'graph':
  case 'topology': {
    let format = 'terminal';
    if (args.includes('--mermaid')) format = 'mermaid';
    else if (args.includes('--json')) format = 'json';
    runGraph(format);
    break;
  }
  case 'doctor':
    runDoctor();
    break;
  case 'list':
    listComponents();
    break;
  case 'scaffold':
  case 'new':
  case 'create': {
    const type = args[1];
    const name = args[2];
    let customTarget = null;
    let isDryRun = false;
    let asJson = false;
    for (let i = 3; i < args.length; i++) {
      if (args[i] === '--dry-run') isDryRun = true;
      else if (args[i] === '--json') asJson = true;
      else if (args[i] === '--workspace' && args[i + 1]) customTarget = args[++i];
    }
    runScaffold(type, name, customTarget, isDryRun, asJson);
    break;
  }
  case 'sync': {
    let isGlobal = false;
    let customTarget = null;
    let isDryRun = false;
    let asJson = false;
    let force = false;
    for (let i = 1; i < args.length; i++) {
      if (args[i] === '--global') isGlobal = true;
      else if (args[i] === '--dry-run') isDryRun = true;
      else if (args[i] === '--json') asJson = true;
      else if (args[i] === '--force') force = true;
      else if (args[i] === '--workspace' && args[i + 1]) customTarget = args[++i];
      else if (!args[i].startsWith('-') && !customTarget) customTarget = args[i];
    }
    runSync(customTarget, isGlobal, isDryRun, asJson, force);
    break;
  }
  case 'new-skill':
    scaffoldSkill(args[1]);
    break;
  case 'new-agent':
    scaffoldAgent(args[1]);
    break;
  case 'add': {
    let customTarget = null;
    let isGlobal = false;
    for (let i = 3; i < args.length; i++) {
      if (args[i] === '--global') isGlobal = true;
      else if (args[i] === '--workspace' && args[i + 1]) customTarget = args[++i];
    }
    addComponent(args[1], args[2], isGlobal, customTarget);
    break;
  }
  case 'remove': {
    let customTarget = null;
    let isGlobal = false;
    for (let i = 3; i < args.length; i++) {
      if (args[i] === '--global') isGlobal = true;
      else if (args[i] === '--workspace' && args[i + 1]) customTarget = args[++i];
    }
    removeComponent(args[1], args[2], isGlobal, customTarget);
    break;
  }
  case 'test-skill':
    testSkill(args[1]);
    break;
  case 'test-all':
  case 'test-skills':
  case 'benchmark': {
    const asJson = args.includes('--json');
    testAllSkills(asJson);
