    { name: 'browser-qa', skills: ['browser-qa-tester', 'playwright-visual-regression'], mcps: ['puppeteer'] },
    { name: 'code-reviewer', skills: ['git-craftsman', 'tdd-workflow', 'repo-onboarding'], mcps: ['github'] },
    { name: 'build-repair', skills: ['root-cause-debugger', 'tdd-workflow'], mcps: [] },
    { name: 'planner', skills: ['subagent-handoff', 'continuous-learning', 'ai-first-engineering', 'harness2-recursive-optimization', 'google-flow-orchestrator', 'gemini-live-multimodal', 'cost-oracle-finops'], mcps: ['sequential-thinking'] },
    { name: 'documentation-writer', skills: ['repo-onboarding', 'api-craftsman'], mcps: ['filesystem'] },
    { name: 'swarm-coordinator', skills: ['ephemeral-swarm-orchestrator', 'dynamic-thinking-allocation', 'ebpf-sandbox-enforcer', 'subagent-handoff', 'continuous-learning'], mcps: ['sequential-thinking'] },
    { name: 'resilience-engineer', skills: ['harness3-mutation-testing', 'envoy-ai-gateway', 'opentelemetry-agent-observability', 'root-cause-debugger', 'security-audit'], mcps: ['sentry'] }
  ];

  const hooks = [
    { name: 'gemini-shield', event: 'PreToolExecution', desc: 'Blocks high-risk file/system commands' },
    { name: 'safety-shield', event: 'PreToolExecution', desc: 'Guards destructive CLI commands' },
    { name: 'secret-scrubber', event: 'PreToolExecution', desc: 'Redacts leaked tokens, private keys & secrets' },
    { name: 'budget-guard', event: 'PreToolExecution', desc: 'Enforces hard USD spend caps and token limits' },
    { name: 'human-gate', event: 'PreToolExecution', desc: 'Enforces interactive human signoff for harness surface changes' },
    { name: 'thinking-budget', event: 'PreToolExecution', desc: 'Enforces reasoning token caps and cognitive limits' },
    { name: 'drift-detector', event: 'PreToolExecution', desc: 'Detects semantic prompt injection and schema drift' },
    { name: 'auto-lint-formatter', event: 'PostToolExecution', desc: 'Auto-formats code files using Prettier/Black' },
    { name: 'ephemeral-context', event: 'SessionStart', desc: 'Injects active git branch, diff & container status' },
    { name: 'learned-instincts', event: 'PostInvocation', desc: 'Persists user feedback & operational instincts' },
    { name: 'goal-verifier', event: 'PostInvocation', desc: 'Verifies objective completeness & test gates' }
  ];

  if (format === 'json') {
    const nodes = [];
    const edges = [];
    agents.forEach(a => {
      nodes.push({ id: `agent:${a.name}`, type: 'agent', label: a.name });
      a.skills.forEach(s => {
        if (!nodes.find(n => n.id === `skill:${s}`)) nodes.push({ id: `skill:${s}`, type: 'skill', label: s });
        edges.push({ source: `agent:${a.name}`, target: `skill:${s}`, relation: 'orchestrates' });
      });
      a.mcps.forEach(m => {
        if (!nodes.find(n => n.id === `mcp:${m}`)) nodes.push({ id: `mcp:${m}`, type: 'mcp', label: m });
        edges.push({ source: `agent:${a.name}`, target: `mcp:${m}`, relation: 'connects' });
      });
    });
    hooks.forEach(h => {
      nodes.push({ id: `hook:${h.name}`, type: 'hook', label: h.name, event: h.event });
      edges.push({ source: `hook:${h.name}`, target: 'lifecycle:antigravity', relation: 'intercepts' });
