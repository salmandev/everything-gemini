  const agents = [
    { name: 'architect', skills: ['architecture-designer', 'database-architect', 'rag-architect', 'graphql-architect', 'api-craftsman', 'grpc-connect-rpc', 'spanner-graph-rag', 'spanner-change-streams'], mcps: ['sequential-thinking'] },
