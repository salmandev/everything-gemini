#!/usr/bin/env node

/**
 * Everything Gemini (everything-gemini) CLI
 * Zero-dependency harness manager for Google Antigravity & Gemini
 */

const fs = require('fs');
const path = require('path');
const os = require('os');
const { execSync } = require('child_process');

const REPO_ROOT = path.resolve(__dirname, '..');
const GLOBAL_CONFIG_DIR = path.join(os.homedir(), '.gemini', 'config');
const WORKSPACE_DIR = process.cwd();
const AGENTS_DIR = path.join(WORKSPACE_DIR, '.agents');

let VERSION = '1.0.1';
try {
  VERSION = require(path.join(REPO_ROOT, 'package.json')).version || '1.0.1';
} catch (_) {}

// ANSI Colors
const RESET = '\x1b[0m';
const BOLD = '\x1b[1m';
const BLUE = '\x1b[34m';
const CYAN = '\x1b[36m';
const GREEN = '\x1b[32m';
const YELLOW = '\x1b[33m';
const RED = '\x1b[31m';
const MAGENTA = '\x1b[35m';
const GRAY = '\x1b[90m';

function printBanner() {
  console.log(`
${CYAN}${BOLD}🪐 Everything Gemini (${GREEN}everything-gemini${CYAN}) v${VERSION}${RESET}
${GRAY}The open-source agent harness & multi-agent orchestrator for Google Gemini & Antigravity${RESET}
`);
}

