  }
}

function runThinking(subAction = 'budget', options = {}) {
  const action = subAction || 'budget';
  const targetTask = options.task || options.target || "Complex distributed transaction refactoring with consensus guarantees";
  const level = options.level || 'deep';
  const budgetTokens = options.budget ? parseInt(options.budget, 10) : (level === 'flash' ? 0 : level === 'balanced' ? 4096 : level === 'exhaustive' ? 24576 : 16384);
  const isDryRun = !!options.dryRun;
  const asJson = !!options.json;
  const startTime = Date.now();

  const cognitiveProfiles = {
    flash: { level: "Flash (Low-Latency)", astDepth: 2, entropyScore: 0.18, model: "gemini-2.0-flash", thinkingTokens: 0, costPer1M: "$0.075", latencyMs: 280 },
    balanced: { level: "Balanced", astDepth: 5, entropyScore: 0.52, model: "gemini-2.5-pro", thinkingTokens: 4096, costPer1M: "$1.25", latencyMs: 890 },
    deep: { level: "Deep Reasoning", astDepth: 12, entropyScore: 0.88, model: "gemini-3.8-extended-thinking", thinkingTokens: 16384, costPer1M: "$2.50", latencyMs: 2450 },
    exhaustive: { level: "Exhaustive Frontier", astDepth: 24, entropyScore: 0.97, model: "gemini-3.8-extended-thinking (max)", thinkingTokens: 24576, costPer1M: "$3.75", latencyMs: 4800 }
  };

  const selectedProfile = cognitiveProfiles[level.toLowerCase()] || cognitiveProfiles.deep;

  const thinkingManifest = {
    engine: "Everything Gemini Dynamic Thinking Allocation",
    version: VERSION,
    action,
    task: targetTask,
    cognitiveLevel: selectedProfile.level,
    astComplexityDepth: selectedProfile.astDepth,
    entropyScore: selectedProfile.entropyScore,
    recommendedModel: selectedProfile.model,
    allocatedThinkingTokens: budgetTokens,
    estimatedLatencyMs: selectedProfile.latencyMs,
    routingDecision: {
      useThinkingTokens: budgetTokens > 0,
      modelRoute: selectedProfile.model,
      safetyGate: "hooks/thinking-budget/"
    }
  };

  if (asJson) {
    console.log(JSON.stringify(thinkingManifest, null, 2));
    return;
  }

  printBanner();
  console.log(`${BOLD}🧠 Dynamic Thinking Allocation & Cognitive Reasoning Router${RESET}`);
  console.log(`Action: ${CYAN}${action}${RESET} | Level: ${CYAN}${level}${RESET} | Target Model: ${BOLD}${selectedProfile.model}${RESET}\n`);
  console.log(`  ${BOLD}Target Task:${RESET} ${targetTask}`);
  console.log(`  ${BOLD}AST Complexity Depth:${RESET} ${selectedProfile.astDepth} levels`);
  console.log(`  ${BOLD}Cognitive Entropy Score:${RESET} ${(selectedProfile.entropyScore * 100).toFixed(0)}%`);
  console.log(`  ${BOLD}Allocated Thinking Budget:${RESET} ${CYAN}${budgetTokens} reasoning tokens${RESET}`);
  console.log(`  ${BOLD}Safety Enforcement:${RESET} ${GREEN}hooks/thinking-budget/ active${RESET}\n`);

  console.log(`${BOLD}COGNITIVE ROUTING TIERS & COMPLEXITY TIERS:${RESET}`);
  console.log(`--------------------------------------------------------------------------------`);
  console.log(`Tier               Target Model                    Thinking Budget  Latency`);
  console.log(`--------------------------------------------------------------------------------`);
  Object.keys(cognitiveProfiles).forEach(k => {
    const prof = cognitiveProfiles[k];
    const isSel = k.toLowerCase() === level.toLowerCase();
    const color = isSel ? GREEN : RESET;
    const tierPad = prof.level.padEnd(18);
    const modelPad = prof.model.padEnd(31);
    const budPad = `${prof.thinkingTokens} tokens`.padEnd(16);
